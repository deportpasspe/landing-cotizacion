---
import QuoteLayout from "../layouts/QuoteLayout.astro";
import { quote } from "../data/quote";

const pageTitle = `${quote.meta.title} | ${quote.issuer.name} para ${quote.client.name}`;
const pageDescription = quote.summary;

const mobileNav = [
  { href: "#alcance", label: "Alcance", short: "1" },
  { href: "#tecnologia", label: "Tecnología", short: "2" },
  { href: "#ventajas", label: "Ventajas", short: "3" },
  { href: "#cliente", label: "Actualización", short: "4" },
  { href: "#tiempos", label: "Tiempos", short: "5" },
  { href: "#inversion", label: "Inversión", short: "6" },
  { href: "#condiciones", label: "Condiciones", short: "7" },
  { href: "#contacto", label: "Contacto", short: "8" },
] as const;
---

<QuoteLayout title={pageTitle} description={pageDescription}>
  <nav class="mobile-nav no-print" aria-label="Secciones de la cotización">
    <div class="mobile-nav__shell">
      <div class="mobile-nav__meta">
        <span class="mobile-nav__meta-label">Ir a sección</span>
        <span class="mobile-nav__meta-progress" data-nav-progress>
          1 / {mobileNav.length}
        </span>
      </div>
      <div class="mobile-nav__scroller" data-nav-scroller>
        <div class="mobile-nav__fade mobile-nav__fade--start" data-nav-fade-start hidden></div>
        <div class="mobile-nav__track" data-nav-track>
          {
            mobileNav.map((item, index) => (
              <a
                class:list={["mobile-nav__link", { "is-active": index === 0 }]}
                href={item.href}
                data-nav-link
                data-nav-index={index + 1}
              >
                <span class="mobile-nav__index" aria-hidden="true">{item.short}</span>
                <span class="mobile-nav__text">{item.label}</span>
              </a>
            ))
          }
        </div>
        <div class="mobile-nav__fade mobile-nav__fade--end" data-nav-fade-end></div>
      </div>
    </div>
  </nav>

  <main class="w-full max-w-full overflow-x-clip py-5 pb-28 sm:py-8 sm:pb-28 md:py-14 md:pb-14 lg:py-16">
    <article class="sheet">
      <header class="px-4 pt-6 pb-8 sm:px-6 sm:pt-8 sm:pb-10 md:px-12 md:pt-12 md:pb-14">
        <div class="mb-6 flex items-start justify-between gap-3 sm:mb-8 sm:items-center sm:gap-4 fade-rise">
          <p class="meta-label m-0 min-w-0 break-all">{quote.meta.reference}</p>
          <button type="button" class="print-btn no-print" onclick="window.print()">
            Imprimir / PDF
          </button>
        </div>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)] lg:items-end lg:gap-10">
          <div class="fade-rise min-w-0">
            <p
              class="display m-0 text-[clamp(2.35rem,11vw,6.5rem)] text-ink text-balance"
            >
              {quote.issuer.name}
            </p>
            <p class="mt-4 prose-measure text-base text-ink-soft sm:text-lg md:text-xl">
              {quote.summary}
            </p>
            <p class="prose-measure mt-3 text-sm text-ink-faint sm:text-base">
              {quote.summarySupport}
            </p>
          </div>

          <dl
            class="fade-rise-delay grid grid-cols-1 gap-x-6 gap-y-4 border-t border-line pt-6 min-[420px]:grid-cols-2 min-w-0 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0"
          >
            <div class="min-w-0">
              <dt class="meta-label">RUC</dt>
              <dd class="m-0 mt-1 font-medium tracking-wide break-all">{quote.issuer.ruc}</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Fecha</dt>
              <dd class="m-0 mt-1 font-medium">{quote.meta.issuedAt}</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Validez</dt>
              <dd class="m-0 mt-1 font-medium">{quote.meta.validDays} días</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Documento</dt>
              <dd class="m-0 mt-1 font-medium break-words">{quote.meta.title}</dd>
            </div>
          </dl>
        </div>

        <div
          class="mt-8 flex flex-col gap-3 border-t border-line pt-6 sm:mt-10 sm:gap-2 md:flex-row md:items-baseline md:justify-between"
        >
          <div class="min-w-0">
            <p class="meta-label m-0">Preparado para</p>
            <p class="display m-0 mt-2 text-xl leading-tight sm:text-2xl md:text-3xl text-balance">
              {quote.client.name}
            </p>
          </div>
          <a
            class="font-medium text-accent underline-offset-4 hover:underline break-all shrink-0"
            href={quote.client.site}
            target="_blank"
            rel="noreferrer"
          >
            {quote.client.siteLabel}
          </a>
        </div>
      </header>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="alcance" aria-labelledby="alcance-title">
        <div class="section-grid">
          <h2 id="alcance-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Alcance</h2>
          <ul class="m-0 list-none space-y-3 p-0 min-w-0">
            {
              quote.scope.map((item) => (
                <li class="border-b border-line/70 pb-3 text-ink-soft break-words last:border-b-0">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="tecnologia" aria-labelledby="tecnologia-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="tecnologia-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Tecnología
            </h2>
            <p class="prose-measure mt-3 text-ink-soft">{quote.stackPitch.lead}</p>
          </div>
          <div class="min-w-0">
            <h3 class="meta-label m-0 mb-4">{quote.stackPitch.title}</h3>
            <ul class="m-0 mb-8 list-none space-y-5 p-0 sm:mb-10">
              {
                quote.stackPitch.points.map((point) => (
                  <li class="border-b border-line pb-5 last:border-b-0 last:pb-0">
                    <p class="m-0 font-medium text-ink">{point.name}</p>
                    <p class="prose-measure m-0 mt-2 text-ink-soft">{point.why}</p>
                  </li>
                ))
              }
            </ul>

            <div class="table-mobile">
              {
                quote.tech.map((row) => (
                  <div class="data-card">
                    <p class="meta-label m-0">{row.layer}</p>
                    <p class="m-0 mt-1 font-medium text-ink">{row.value}</p>
                    <p class="data-card__meta text-ink-soft">{row.note}</p>
                  </div>
                ))
              }
            </div>

            <div class="table-desktop table-scroll">
              <table>
                <thead>
                  <tr class="border-b border-ink">
                    <th class="meta-label pb-3 pr-3 font-medium">Capa</th>
                    <th class="meta-label pb-3 pr-3 font-medium">Stack</th>
                    <th class="meta-label pb-3 font-medium">Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    quote.tech.map((row) => (
                      <tr class="border-b border-line align-top">
                        <td class="py-4 pr-3 text-ink-soft whitespace-nowrap">{row.layer}</td>
                        <td class="py-4 pr-3 font-medium text-ink whitespace-nowrap">{row.value}</td>
                        <td class="py-4 text-ink-soft">{row.note}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <p class="mt-5 text-sm text-ink-soft break-words">
              Stack recomendado:{" "}
              <strong class="font-medium text-ink">Astro + Sanity + TravelClick</strong>,
              con SEO/AEO de base. Sin frameworks de aplicación pesados: el producto es una
              experiencia de marca orientada a reserva directa.
            </p>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="ventajas" aria-labelledby="ventajas-title">
        <div class="section-grid">
          <h2 id="ventajas-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Ventajas</h2>
          <ul class="stack-list text-ink-soft min-w-0">
            {
              quote.advantages.map((item) => (
                <li class="break-words">{item}</li>
              ))
            }
          </ul>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="cliente" aria-labelledby="cliente-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="cliente-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Actualización
            </h2>
            <p class="prose-measure mt-3 text-ink-soft">
              Desarrollo a cargo de UX Factory; operación editorial diaria a cargo del hotel.
            </p>
          </div>
          <div class="grid gap-8 sm:grid-cols-2 min-w-0">
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Durante el proyecto</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.during.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Día a día en Sanity</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.daily.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Queda en TravelClick</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.travelclick.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Interviene UX Factory</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.uxFactory.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="tiempos" aria-labelledby="tiempos-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="tiempos-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Tiempos</h2>
            <p class="mt-3 text-xl font-medium text-accent sm:text-2xl">{quote.timeline.total}</p>
          </div>

          <div class="min-w-0">
            <div class="table-mobile">
              {
                quote.timeline.phases.map((phase) => (
                  <div class="data-card">
                    <p class="m-0 font-medium text-ink">{phase.name}</p>
                    <p class="meta-label m-0 mt-2">{phase.duration}</p>
                    <p class="data-card__meta text-ink-soft">{phase.deliverable}</p>
                  </div>
                ))
              }
            </div>

            <div class="table-desktop table-scroll">
              <table>
                <thead>
                  <tr class="border-b border-ink">
                    <th class="meta-label pb-3 pr-3 font-medium">Fase</th>
                    <th class="meta-label pb-3 pr-3 font-medium">Duración</th>
                    <th class="meta-label pb-3 font-medium">Entregable</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    quote.timeline.phases.map((phase) => (
                      <tr class="border-b border-line align-top">
                        <td class="py-4 pr-3 font-medium text-ink">{phase.name}</td>
                        <td class="py-4 pr-3 whitespace-nowrap text-ink-soft">{phase.duration}</td>
                        <td class="py-4 text-ink-soft">{phase.deliverable}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section
        class="invest-band px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12"
        id="inversion" aria-labelledby="inversion-title"
      >
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="inversion-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl text-accent-ink">
              Inversión
            </h2>
            <p class="meta-label mt-5 mb-0">{quote.investment.totalLabel}</p>
            <p class="mt-2 display text-[clamp(1.65rem,7vw,3.25rem)] leading-[1.05] break-words">
              USD {quote.investment.packageRange}
            </p>
            <p class="mt-4 max-w-prose text-sm leading-relaxed text-accent-ink/85">
              {quote.investment.totalNote}
            </p>
          </div>
          <div class="min-w-0">
            <div class="table-mobile">
              {
                quote.investment.items.map((item) => (
                  <div class="data-card">
                    <p class="m-0 text-accent-ink/90">{item.concept}</p>
                    <p class="data-card__meta text-accent-ink">{item.range}</p>
                  </div>
                ))
              }
              <div class="data-card border-b-0">
                <p class="m-0 font-medium text-accent-ink">{quote.investment.totalLabel}</p>
                <p class="data-card__meta text-accent-ink">
                  {quote.investment.packageRange}
                </p>
              </div>
            </div>

            <div class="table-desktop table-scroll">
              <table>
                <thead>
                  <tr class="border-b border-accent-ink/35">
                    <th class="meta-label pb-3 pr-3 font-medium">Concepto</th>
                    <th class="meta-label pb-3 font-medium text-right">Rango USD</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    quote.investment.items.map((item) => (
                      <tr class="border-b border-accent-ink/20 align-top">
                        <td class="py-3.5 pr-3 text-accent-ink/90">{item.concept}</td>
                        <td class="py-3.5 text-right font-medium whitespace-nowrap">
                          {item.range}
                        </td>
                      </tr>
                    ))
                  }
                  <tr class="align-top">
                    <td class="pt-5 pr-3 font-medium text-accent-ink">
                      {quote.investment.totalLabel}
                    </td>
                    <td class="pt-5 text-right font-medium whitespace-nowrap text-accent-ink">
                      {quote.investment.packageRange}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <p class="mt-6 border border-accent-ink/30 bg-accent/40 px-3 py-3 text-sm font-medium sm:px-4">
              {quote.investment.note}
            </p>
            <p class="mt-3 text-sm text-accent-ink/80">{quote.investment.platformNote}</p>
          </div>
        </div>
      </section>

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="condiciones" aria-labelledby="condiciones-title">
        <div class="section-grid">
          <h2 id="condiciones-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
            Condiciones
          </h2>
          <ul class="m-0 list-disc space-y-3 pl-5 text-ink-soft min-w-0">
            {quote.terms.map((item) => <li class="break-words">{item}</li>)}
          </ul>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="siguiente">
        <div class="grid gap-6 min-w-0 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <div class="min-w-0">
            <h2 id="siguiente" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Siguiente paso
            </h2>
            <p class="prose-measure mt-4 text-base text-ink-soft sm:text-lg">{quote.nextStep}</p>
          </div>
          <p class="m-0 text-sm text-ink-faint md:text-right">
            Cotización emitida por {quote.issuer.name}
          </p>
        </div>
      </section>

      <footer id="contacto" class="border-t border-line px-4 py-6 sm:px-6 sm:py-8 md:px-12">
        <div
          class="flex flex-col gap-4 text-sm text-ink-soft md:flex-row md:items-start md:justify-between"
        >
          <p class="m-0 break-words">
            <span class="font-medium text-ink">{quote.issuer.name}</span>
            {" "}| RUC {quote.issuer.ruc}
          </p>
          <div class="flex min-w-0 flex-col gap-3 md:items-end">
            {
              quote.issuer.contacts.map((contact) => (
                <p class="m-0 flex min-w-0 flex-col gap-0.5 sm:block">
                  <span class="font-medium text-ink">{contact.name}</span>
                  <span class="hidden sm:inline">{" "}</span>
                  <a
                    class="text-accent underline-offset-4 hover:underline break-all"
                    href={contact.whatsappHref}
                    target="_blank"
                    rel="noreferrer"
                  >
                    WhatsApp {contact.whatsapp}
                  </a>
                </p>
              ))
            }
          </div>
        </div>
      </footer>
    </article>
  </main>

  <script define:vars={{ navTotal: mobileNav.length }}>
    const total = navTotal as number;
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    );
    const track = document.querySelector<HTMLElement>("[data-nav-track]");
    const progressEl = document.querySelector<HTMLElement>("[data-nav-progress]");
    const fadeStart = document.querySelector<HTMLElement>("[data-nav-fade-start]");
    const fadeEnd = document.querySelector<HTMLElement>("[data-nav-fade-end]");
    let currentId = links[0]?.getAttribute("href")?.slice(1) ?? "";

    const sections = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    const updateFades = () => {
      if (!track || !fadeStart || !fadeEnd) return;
      const max = track.scrollWidth - track.clientWidth;
      const left = track.scrollLeft;
      fadeStart.hidden = left <= 4;
      fadeEnd.hidden = left >= max - 4;
    };

    const setActive = (id: string, fromClick = false) => {
      if (!id || (id === currentId && !fromClick)) return;
      currentId = id;

      for (const link of links) {
        const active = link.getAttribute("href") === `#${id}`;
        link.classList.toggle("is-active", active);
        if (active) {
          link.setAttribute("aria-current", "location");
          const index = link.dataset.navIndex ?? "1";
          if (progressEl) progressEl.textContent = `${index} / ${total}`;
          link.scrollIntoView({
            inline: "center",
            block: "nearest",
            behavior: fromClick ? "smooth" : "auto",
          });
        } else {
          link.removeAttribute("aria-current");
        }
      }
      requestAnimationFrame(updateFades);
    };

    if (track) {
      track.addEventListener("scroll", updateFades, { passive: true });
      updateFades();
      window.addEventListener("resize", updateFades, { passive: true });
    }

    if (sections.length && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target?.id) setActive(visible.target.id);
        },
        {
          rootMargin: "-18% 0px -52% 0px",
          threshold: [0.08, 0.2, 0.4, 0.6],
        },
      );

      for (const section of sections) observer.observe(section);
    }

    for (const link of links) {
      link.addEventListener("click", () => {
        const id = link.getAttribute("href")?.slice(1);
        if (id) setActive(id, true);
      });
    }
  </script>
</QuoteLayout>
