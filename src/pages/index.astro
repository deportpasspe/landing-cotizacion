---
import QuoteLayout from "../layouts/QuoteLayout.astro";
import { quote } from "../data/quote";

const pageTitle = `${quote.meta.title} | ${quote.issuer.name} para ${quote.client.name}`;
const pageDescription = quote.summary;

const mobileNav = [
  { href: "#diagnostico", label: "Diagnóstico", short: "1" },
  { href: "#ux-ui", label: "UX / UI", short: "2" },
  { href: "#alcance", label: "Alcance", short: "3" },
  { href: "#tecnologia", label: "Tecnología", short: "4" },
  { href: "#responsabilidades", label: "Operación", short: "5" },
  { href: "#tiempos", label: "Fases", short: "6" },
  { href: "#inversion", label: "Inversión", short: "7" },
  { href: "#condiciones", label: "Condiciones", short: "8" },
  { href: "#contacto", label: "Contacto", short: "9" },
] as const;
---

<QuoteLayout title={pageTitle} description={pageDescription}>
  <nav class="mobile-nav no-print" aria-label="Secciones de la cotización">
    <div class="mobile-nav__shell">
      <div class="mobile-nav__meta">
        <span class="mobile-nav__meta-label">Ir a sección</span>
        <span class="mobile-nav__meta-progress" data-nav-progress>
          1 / {mobileNav.length}
        </span>
      </div>
      <div class="mobile-nav__scroller" data-nav-scroller>
        <div class="mobile-nav__fade mobile-nav__fade--start" data-nav-fade-start hidden></div>
        <div class="mobile-nav__track" data-nav-track>
          {
            mobileNav.map((item, index) => (
              <a
                class:list={["mobile-nav__link", { "is-active": index === 0 }]}
                href={item.href}
                data-nav-link
                data-nav-index={index + 1}
              >
                <span class="mobile-nav__index" aria-hidden="true">{item.short}</span>
                <span class="mobile-nav__text">{item.label}</span>
              </a>
            ))
          }
        </div>
        <div class="mobile-nav__fade mobile-nav__fade--end" data-nav-fade-end></div>
      </div>
    </div>
  </nav>

  <main class="w-full max-w-full overflow-x-clip py-5 pb-28 sm:py-8 sm:pb-28 md:py-14 md:pb-14 lg:py-16">
    <article class="sheet">
      <header class="px-4 pt-6 pb-8 sm:px-6 sm:pt-8 sm:pb-10 md:px-12 md:pt-12 md:pb-14">
        <div class="mb-6 flex items-start justify-between gap-3 sm:mb-8 sm:items-center sm:gap-4 fade-rise">
          <p class="meta-label m-0 min-w-0 break-all">{quote.meta.reference}</p>
          <div class="flex items-center gap-2 no-print">
            <button type="button" class="print-btn" onclick="window.print()">
              Imprimir / PDF
            </button>
          </div>
        </div>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)] lg:items-end lg:gap-10">
          <div class="fade-rise min-w-0">
            <p
              class="display m-0 text-[clamp(2.35rem,11vw,6.5rem)] text-ink text-balance"
            >
              {quote.issuer.name}
            </p>
            <p class="mt-4 prose-measure text-base text-ink-soft sm:text-lg md:text-xl">
              {quote.summary}
            </p>
            <p class="prose-measure mt-3 text-sm text-ink-faint sm:text-base">
              {quote.summarySupport}
            </p>
          </div>

          <dl
            class="fade-rise-delay grid grid-cols-1 gap-x-6 gap-y-4 border-t border-line pt-6 min-[420px]:grid-cols-2 min-w-0 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0"
          >
            <div class="min-w-0">
              <dt class="meta-label">RUC</dt>
              <dd class="m-0 mt-1 font-medium tracking-wide break-all">{quote.issuer.ruc}</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Fecha</dt>
              <dd class="m-0 mt-1 font-medium">{quote.meta.issuedAt}</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Validez</dt>
              <dd class="m-0 mt-1 font-medium">{quote.meta.validDays} días</dd>
            </div>
            <div class="min-w-0">
              <dt class="meta-label">Documento</dt>
              <dd class="m-0 mt-1 font-medium break-words">{quote.meta.title}</dd>
            </div>
          </dl>
        </div>

        <div
          class="mt-8 flex flex-col gap-3 border-t border-line pt-6 sm:mt-10 sm:gap-2 md:flex-row md:items-baseline md:justify-between"
        >
          <div class="min-w-0">
            <p class="meta-label m-0">Preparado para</p>
            <p class="display m-0 mt-2 text-xl leading-tight sm:text-2xl md:text-3xl text-balance">
              {quote.client.name}
            </p>
          </div>
          <a
            class="font-medium text-accent underline-offset-4 hover:underline break-all shrink-0"
            href={quote.client.site}
            target="_blank"
            rel="noreferrer"
          >
            {quote.client.siteLabel}
          </a>
        </div>
      </header>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="diagnostico" aria-labelledby="diagnostico-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="diagnostico-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Diagnóstico</h2>
            <p class="prose-measure mt-3 text-ink-soft">{quote.context.lead}</p>
          </div>
          <div class="min-w-0">
            <h3 class="meta-label m-0 mb-4">Requerimientos definidos con Valeria</h3>
            <div class="space-y-5">
              {quote.context.findings.map((finding) => (
                <article class="border-b border-line pb-5 last:border-b-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="m-0 font-medium text-ink">{finding.title}</h4>
                    <span class="meta-label text-accent">{finding.impact}</span>
                  </div>
                  <p class="prose-measure m-0 mt-2 text-ink-soft">{finding.detail}</p>
                </article>
              ))}
            </div>
            <h3 class="meta-label m-0 mt-8 mb-3">Oportunidades para la nueva solución</h3>
            <ul class="m-0 list-disc space-y-2 pl-5 text-ink-soft">
              {quote.context.opportunities.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="ux-ui" aria-labelledby="ux-ui-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="ux-ui-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">UX antes de UI. UI antes de código.</h2>
            <p class="prose-measure mt-4 text-ink-soft">{quote.uxUi.lead}</p>
          </div>
          <div class="min-w-0">
            <div class="space-y-6">
              {quote.uxUi.services.map((service) => (
                <article class="border-b border-line pb-6 last:border-b-0">
                  <h3 class="m-0 text-lg font-medium text-ink">{service.stage}</h3>
                  <p class="m-0 mt-2 text-ink-soft"><strong class="font-medium text-ink">Por qué:</strong> {service.why}</p>
                  <p class="m-0 mt-2 text-sm text-ink-faint"><strong class="font-medium text-ink-soft">Entregables:</strong> {service.outputs}</p>
                </article>
              ))}
            </div>
            <p class="mt-7 border border-accent/40 bg-accent-soft/45 px-4 py-4 text-sm font-medium text-ink">{quote.uxUi.gate}</p>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="alcance" aria-labelledby="alcance-title">
        <div class="section-grid">
          <h2 id="alcance-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Alcance</h2>
          <div class="min-w-0 space-y-8">
            <ul class="m-0 list-none space-y-3 p-0">
              {
                quote.scope.map((item) => (
                  <li class="border-b border-line/70 pb-3 text-ink-soft break-words last:border-b-0">
                    {item}
                  </li>
                ))
              }
            </ul>
            <div>
              <h3 class="meta-label m-0 mb-3">Módulos de la solución</h3>
              <ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2">
                {
                  quote.modules.map((item) => (
                    <li class="border border-line bg-paper/70 px-3 py-2 text-sm text-ink-soft">
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="tecnologia" aria-labelledby="tecnologia-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="tecnologia-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Tecnología
            </h2>
            <p class="prose-measure mt-3 text-ink-soft">{quote.stackPitch.lead}</p>
          </div>
          <div class="min-w-0">
            <h3 class="meta-label m-0 mb-4">{quote.stackPitch.title}</h3>
            <ul class="m-0 mb-8 list-none space-y-5 p-0 sm:mb-10">
              {
                quote.stackPitch.points.map((point) => (
                  <li class="border-b border-line pb-5 last:border-b-0 last:pb-0">
                    <p class="m-0 font-medium text-ink">{point.name}</p>
                    <p class="prose-measure m-0 mt-2 text-ink-soft">{point.why}</p>
                  </li>
                ))
              }
            </ul>

            <div class="table-mobile">
              {
                quote.tech.map((row) => (
                  <div class="data-card">
                    <p class="meta-label m-0">{row.layer}</p>
                    <p class="m-0 mt-1 font-medium text-ink">{row.value}</p>
                    <p class="data-card__meta text-ink-soft">{row.note}</p>
                  </div>
                ))
              }
            </div>

            <div class="table-desktop table-scroll">
              <table>
                <thead>
                  <tr class="border-b border-ink">
                    <th class="meta-label pb-3 pr-3 font-medium">Capa</th>
                    <th class="meta-label pb-3 pr-3 font-medium">Stack</th>
                    <th class="meta-label pb-3 font-medium">Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    quote.tech.map((row) => (
                      <tr class="border-b border-line align-top">
                        <td class="py-4 pr-3 text-ink-soft whitespace-nowrap">{row.layer}</td>
                        <td class="py-4 pr-3 font-medium text-ink whitespace-nowrap">{row.value}</td>
                        <td class="py-4 text-ink-soft">{row.note}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <p class="mt-5 text-sm text-ink-soft break-words">
              Ver el análisis completo en la{" "}
              <a class="font-medium text-accent underline-offset-4 hover:underline" href="/propuesta-tecnica/">comparativa técnica</a>.
              La recomendación inicial es <strong class="font-medium text-ink">cuenta + wizard + recomendación + WhatsApp</strong>.
              La opción 2 agrega solicitud e historial de pedidos, manteniendo pago y delivery manuales.
            </p>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="ventajas-title">
        <div class="section-grid">
          <h2 id="ventajas-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Ventajas</h2>
          <ul class="stack-list text-ink-soft min-w-0">
            {
              quote.advantages.map((item) => (
                <li class="break-words">{item}</li>
              ))
            }
          </ul>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="responsabilidades" aria-labelledby="cliente-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="cliente-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Responsabilidades
            </h2>
            <p class="prose-measure mt-3 text-ink-soft">
              La plataforma ayuda a evaluar, recomendar y vender, pero la operación nutricional y logística sigue siendo responsabilidad del negocio.
            </p>
          </div>
          <div class="grid gap-8 sm:grid-cols-2 min-w-0">
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Durante el proyecto</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.during.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Día a día en el panel</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.daily.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Queda en la operación</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.operations.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-medium text-ink">Interviene UX Factory</h3>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
                {quote.clientRole.uxFactory.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="tiempos" aria-labelledby="tiempos-title">
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="tiempos-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">Tiempos</h2>
            <p class="mt-3 text-xl font-medium text-accent sm:text-2xl">{quote.timeline.total}</p>
            <p class="prose-measure mt-3 text-sm text-ink-soft">{quote.timeline.note}</p>
          </div>

          <div class="min-w-0">
            <h3 class="meta-label m-0 mb-4">Plan de trabajo</h3>
            <div class="table-mobile">
              {
                quote.timeline.phases.map((phase) => (
                  <div class="data-card">
                    <p class="m-0 font-medium text-ink">{phase.name}</p>
                    <p class="meta-label m-0 mt-2">{phase.duration}</p>
                    <p class="data-card__meta text-ink-soft">{phase.deliverable}</p>
                  </div>
                ))
              }
            </div>

            <div class="table-desktop table-scroll">
              <table>
                <thead>
                  <tr class="border-b border-ink">
                    <th class="meta-label pb-3 pr-3 font-medium">Fase</th>
                    <th class="meta-label pb-3 pr-3 font-medium">Duración</th>
                    <th class="meta-label pb-3 font-medium">Entregable</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    quote.timeline.phases.map((phase) => (
                      <tr class="border-b border-line align-top">
                        <td class="py-4 pr-3 font-medium text-ink">{phase.name}</td>
                        <td class="py-4 pr-3 whitespace-nowrap text-ink-soft">{phase.duration}</td>
                        <td class="py-4 text-ink-soft">{phase.deliverable}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section
        class="invest-band px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12"
        id="inversion" aria-labelledby="inversion-title"
      >
        <div class="section-grid">
          <div class="min-w-0">
            <h2 id="inversion-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl text-accent-ink">
              Inversión estimada
            </h2>
            <p class="meta-label mt-5 mb-0">{quote.investment.totalLabel}</p>
            <p class="mt-2 display text-[clamp(1.65rem,7vw,3.25rem)] leading-[1.05] break-words">
              {quote.investment.currencyLabel} {quote.investment.packageRange}
            </p>
            <p class="mt-4 max-w-prose text-sm leading-relaxed text-accent-ink/85">
              {quote.investment.totalNote}
            </p>
          </div>
          <div class="min-w-0">
            <h3 class="meta-label m-0 mb-4">Dos opciones de inversión</h3>
            <div class="space-y-8">
              {quote.investment.packages.map((item) => (
                <article class="border-b border-accent-ink/30 pb-8 last:border-b-0 last:pb-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <p class="m-0 font-medium text-accent-ink">{item.name}</p>
                    <p class="m-0 font-medium text-accent-ink">S/ {item.price}</p>
                  </div>
                  <p class="meta-label m-0 mt-1">{item.time}</p>
                  <p class="m-0 mt-2 text-sm text-accent-ink/80">{item.fit}</p>
                  <p class="meta-label m-0 mt-5 mb-2">Incluye</p>
                  <ul class="m-0 list-disc space-y-2 pl-5 text-sm text-accent-ink/90">
                    {item.includes.map((included) => <li>{included}</li>)}
                  </ul>
                </article>
              ))}
            </div>
            <p class="mt-6 border border-accent-ink/30 bg-accent/40 px-3 py-3 text-sm font-medium sm:px-4">
              {quote.investment.note}
            </p>
            <p class="mt-3 text-sm text-accent-ink/80">{quote.investment.platformNote}</p>
          </div>
        </div>
      </section>

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" id="condiciones" aria-labelledby="condiciones-title">
        <div class="section-grid">
          <h2 id="condiciones-title" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
            Condiciones
          </h2>
          <div class="min-w-0 space-y-8">
            <div>
              <h3 class="meta-label m-0 mb-3">Condiciones comerciales</h3>
              <ul class="m-0 list-disc space-y-3 pl-5 text-ink-soft">
                {quote.terms.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="meta-label m-0 mb-3">No incluido</h3>
              <ul class="m-0 list-disc space-y-3 pl-5 text-ink-soft">
                {quote.exclusions.map((item) => <li class="break-words">{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-rule" />

      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="siguiente">
        <div class="grid gap-6 min-w-0 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <div class="min-w-0">
            <h2 id="siguiente" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
              Siguiente paso
            </h2>
            <p class="prose-measure mt-4 text-base text-ink-soft sm:text-lg">{quote.nextStep}</p>
          </div>
          <p class="m-0 text-sm text-ink-faint md:text-right">
            Cotización emitida por {quote.issuer.name}
          </p>
        </div>
      </section>

      <footer id="contacto" class="border-t border-line px-4 py-6 sm:px-6 sm:py-8 md:px-12">
        <div class="footer-contact">
          <div class="footer-contact__intro">
            <p class="meta-label m-0">Contacto</p>
            <div class="footer-contact__brand">
              <p class="display footer-contact__name m-0 text-[1.85rem] sm:text-3xl md:text-4xl">
                {quote.issuer.name}
              </p>
              <p class="footer-contact__ruc m-0">RUC {quote.issuer.ruc}</p>
            </div>
            <p class="footer-contact__hint m-0">
              Escríbenos por WhatsApp para agendar la sesión de alcance o resolver dudas de la propuesta.
            </p>
          </div>
          <div class="contact-actions">
            {
              quote.issuer.contacts.map((contact) => (
                <a
                  class="wa-btn"
                  href={contact.whatsappHref}
                  target="_blank"
                  rel="noreferrer"
                >
                  <span class="wa-btn__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.33.16 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.76 1.47h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.44-8.44ZM12.07 21.15h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.64-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.44 9.87-9.89 9.87Zm5.43-7.4c-.3-.15-1.76-.87-2.03-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48a8.97 8.97 0 0 1-1.66-2.06c-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
                    </svg>
                  </span>
                  <span class="wa-btn__copy">
                    <span class="wa-btn__name">{contact.name}</span>
                    <span class="wa-btn__number">{contact.whatsapp}</span>
                  </span>
                  <span class="wa-btn__cta">Escribir</span>
                </a>
              ))
            }
          </div>
        </div>
      </footer>
    </article>
  </main>

  <script define:vars={{ navTotal: mobileNav.length }}>
    const total = Number(navTotal);
    const links = Array.from(
      document.querySelectorAll("[data-nav-link]"),
    );
    const track = document.querySelector("[data-nav-track]");
    const progressEl = document.querySelector("[data-nav-progress]");
    const fadeStart = document.querySelector("[data-nav-fade-start]");
    const fadeEnd = document.querySelector("[data-nav-fade-end]");
    let currentId = "";
    let clicking = false;
    let clickTimer = 0;

    const sections = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1) ?? "";
        const el = id ? document.getElementById(id) : null;
        return el ? { id, el } : null;
      })
      .filter(Boolean);

    const updateFades = () => {
      if (!track || !fadeStart || !fadeEnd) return;
      const max = track.scrollWidth - track.clientWidth;
      const left = track.scrollLeft;
      fadeStart.hidden = left <= 4;
      fadeEnd.hidden = max <= 4 || left >= max - 4;
    };

    const setActive = (id, fromClick = false) => {
      if (!id || id === currentId) {
        if (fromClick && progressEl) {
          const link = links.find((item) => item.getAttribute("href") === `#${id}`);
          const index = link?.dataset.navIndex ?? "1";
          progressEl.textContent = `${index} / ${total}`;
        }
        return;
      }
      currentId = id;

      for (const link of links) {
        const active = link.getAttribute("href") === `#${id}`;
        link.classList.toggle("is-active", active);
        if (active) {
          link.setAttribute("aria-current", "location");
          const index = link.dataset.navIndex ?? "1";
          if (progressEl) progressEl.textContent = `${index} / ${total}`;
          link.scrollIntoView({
            inline: "center",
            block: "nearest",
            behavior: fromClick ? "smooth" : "auto",
          });
        } else {
          link.removeAttribute("aria-current");
        }
      }
      requestAnimationFrame(updateFades);
    };

    const syncFromScroll = () => {
      if (clicking || !sections.length) return;

      // Línea de lectura: encima del menú fijo (zona usable de la pantalla)
      const probe = Math.min(window.innerHeight * 0.28, 180);
      let activeId = sections[0].id;

      for (const section of sections) {
        const top = section.el.getBoundingClientRect().top;
        if (top - probe <= 0) activeId = section.id;
      }

      // Al llegar al fondo, forzar la última sección (Contacto)
      const doc = document.documentElement;
      const atBottom =
        window.scrollY + window.innerHeight >= doc.scrollHeight - 24;
      if (atBottom) activeId = sections[sections.length - 1].id;

      setActive(activeId);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        syncFromScroll();
      });
    };

    if (track) {
      track.addEventListener("scroll", updateFades, { passive: true });
      updateFades();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      updateFades();
      syncFromScroll();
    }, { passive: true });

    for (const link of links) {
      link.addEventListener("click", () => {
        const id = link.getAttribute("href")?.slice(1);
        if (!id) return;
        clicking = true;
        setActive(id, true);
        window.clearTimeout(clickTimer);
        clickTimer = window.setTimeout(() => {
          clicking = false;
          syncFromScroll();
        }, 700);
      });
    }

    syncFromScroll();
  </script>
</QuoteLayout>
