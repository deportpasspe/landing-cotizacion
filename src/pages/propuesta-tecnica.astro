---
import QuoteLayout from "../layouts/QuoteLayout.astro";
import { stacks, decisionMatrix } from "../data/stacks";
import { quote } from "../data/quote";

const pageTitle = `Propuesta técnica | ${quote.issuer.name}`;
const pageDescription =
  "Comparativa de alcance para rediseñar MTB XC Pongo de Maenique y ordenar sus inscripciones.";

const allStacks = [stacks.commerce, stacks.recommended, stacks.custom] as const;
---

<QuoteLayout title={pageTitle} description={pageDescription}>
  <main class="w-full max-w-full overflow-x-clip py-5 pb-8 sm:py-8 md:py-14 lg:py-16">
    <article class="sheet">
      <header class="px-4 pt-6 pb-8 sm:px-6 sm:pt-8 sm:pb-10 md:px-12 md:pt-12 md:pb-14">
        <div class="mb-6 flex items-start justify-between gap-3 sm:mb-8 sm:items-center sm:gap-4 fade-rise">
          <p class="meta-label m-0 min-w-0 break-all">Propuesta técnica</p>
        </div>

        <div class="fade-rise min-w-0">
          <h1 class="display m-0 text-[clamp(2.35rem,9vw,4.5rem)] text-ink text-balance">
            Qué solución elegir
          </h1>
          <p class="prose-measure mt-4 text-base text-ink-soft sm:text-lg md:text-xl">
            Dos opciones para relanzar la experiencia y una evolución futura. La diferencia principal está en mantener la validación humana del pago o integrar inscripción, pago y cupo en un solo recorrido.
          </p>
          <p class="prose-measure mt-3 text-sm text-ink-faint sm:text-base">
            Esta comparativa es transparente: presentamos pros, contras y una matriz de decisión. La recomendación es clara, pero la decisión es del cliente.
          </p>
        </div>
      </header>

      <hr class="section-rule" />

      <!-- Stack cards -->
      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="opciones">
        <h2 id="opciones" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl mb-8">
          Las tres opciones
        </h2>
        <div class="space-y-8">
          {
            allStacks.map((stack, i) => (
              <div class:list={["stack-card", { "stack-card--recommended": i === 1 }]}>
                <div class="stack-card__header">
                  <div>
                    <p class="meta-label m-0">{stack.tagline}</p>
                    <h3 class="display m-0 mt-1 text-xl sm:text-2xl md:text-3xl">{stack.name}</h3>
                  </div>
                  <div class="stack-card__score">
                    <span class="stack-card__score-label">Producto</span>
                    <span class="stack-card__score-value">{stack.productScore}</span>
                  </div>
                </div>

                <p class="stack-card__verdict">{stack.verdict}</p>

                <div class="grid gap-6 sm:grid-cols-2">
                  <div>
                    <h4 class="meta-label m-0 mb-3">Ventajas</h4>
                    <ul class="stack-list text-ink-soft">
                      {stack.pros.map((item) => (
                        <li class="break-words">
                          <span class="stack-card__pro" aria-hidden="true">+</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="meta-label m-0 mb-3">Limitaciones</h4>
                    <ul class="stack-list text-ink-soft">
                      {stack.cons.map((item) => (
                        <li class="break-words">
                          <span class="stack-card__con" aria-hidden="true">-</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="stack-card__footer">
                  <p class="text-sm text-ink-faint">
                    <strong class="font-medium text-ink-soft">Ideal para:</strong> {stack.bestFor}
                  </p>
                  <p class="text-sm text-ink-faint mt-2">
                    <strong class="font-medium text-ink-soft">Para este proyecto:</strong> {stack.productNote}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <hr class="section-rule" />

      <!-- Decision matrix -->
      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="matriz">
        <h2 id="matriz" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl mb-2">
          Matriz de decisión
        </h2>
        <p class="prose-measure mb-8 text-sm text-ink-faint">
          Del 1 (mínimo) al 5 (máximo). Evaluación orientativa para narrativa, inscripción, pagos, operación, experiencia internacional y evolución del evento.
        </p>

        <div class="table-scroll">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th class="meta-label pb-3 pr-3 font-medium">Dimensión</th>
                <th class="meta-label pb-3 pr-3 font-medium">Inscripción asistida</th>
                <th class="meta-label pb-3 pr-3 font-medium">Pago online</th>
                <th class="meta-label pb-3 font-medium">Ecosistema de carrera</th>
              </tr>
            </thead>
            <tbody>
              {
                decisionMatrix.map((row) => (
                  <tr class="border-b border-line align-top">
                    <td class="py-3 pr-3 text-ink-soft">{row.dimension}</td>
                    <td class="py-3 pr-3">
                      <span class:list={["score", { "score--low": Number(row.commerce) <= 2, "score--mid": Number(row.commerce) === 3, "score--high": Number(row.commerce) >= 4 }]}>
                        {row.commerce}
                      </span>
                    </td>
                    <td class="py-3 pr-3">
                      <span class:list={["score", { "score--low": Number(row.recommended) <= 2, "score--mid": Number(row.recommended) === 3, "score--high": Number(row.recommended) >= 4 }]}>
                        {row.recommended}
                      </span>
                    </td>
                    <td class="py-3">
                      <span class:list={["score", { "score--low": Number(row.custom) <= 2, "score--mid": Number(row.custom) === 3, "score--high": Number(row.custom) >= 4 }]}>
                        {row.custom}
                      </span>
                    </td>
                  </tr>
                ))
              }
              <tr class="border-t-2 border-ink font-medium">
                <td class="py-4 pr-3 text-ink">Promedio</td>
                <td class="py-4 pr-3">
                  <span class="score score--mid">3.4</span>
                </td>
                <td class="py-4 pr-3">
                  <span class="score score--high">4.4</span>
                </td>
                <td class="py-4">
                  <span class="score score--high">3.9</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <hr class="section-rule" />

      <!-- Recommendation -->
      <section class="invest-band px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="recomendacion">
        <div class="max-w-prose">
          <h2 id="recomendacion" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl text-accent-ink">
            Nuestra recomendación
          </h2>
          <p class="mt-5 text-lg text-accent-ink/90 leading-relaxed">
            Recomendamos la <strong>inscripción y pago online</strong> como solución objetivo: elimina el recorrido doble, vincula el pago con el participante y confirma el cupo sin depender de comprobantes revisados uno por uno.
          </p>
          <p class="mt-4 text-accent-ink/80 leading-relaxed">
            Si el presupuesto o la fecha de lanzamiento requieren una salida gradual, la <strong>inscripción asistida</strong> sigue siendo una primera etapa válida: mantiene la transferencia, pero deja una sola tarifa, un solo formulario y estados operativos claros.
          </p>
          <p class="mt-4 text-accent-ink/80 leading-relaxed">
            El <strong>ecosistema de carrera</strong> —tracking, cronometraje, resultados en vivo, app y fidelización— debe quedar en el roadmap. Es una capa operativa distinta al rediseño y conviene abordarla cuando los procesos y proveedores estén consolidados.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center border border-accent-ink bg-accent-ink px-6 py-3 text-sm font-medium text-accent no-underline transition-colors hover:bg-transparent hover:text-accent-ink"
            >
              Volver a la cotización
            </a>
          </div>
        </div>
      </section>

      <footer class="border-t border-line px-4 py-6 sm:px-6 sm:py-8 md:px-12">
        <p class="m-0 text-sm text-ink-faint">
          Propuesta técnica de <span class="font-medium text-ink-soft">{quote.issuer.name}</span> para {quote.client.name}
        </p>
      </footer>
    </article>
  </main>
</QuoteLayout>
