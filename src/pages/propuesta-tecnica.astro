---
import QuoteLayout from "../layouts/QuoteLayout.astro";
import { stacks, decisionMatrix } from "../data/stacks";
import { quote } from "../data/quote";

const pageTitle = `Propuesta técnica | ${quote.issuer.name}`;
const pageDescription =
  "Comparativa técnica WordPress + Elementor vs Astro + Sanity vs Astro + WordPress headless para el sitio Dazzler Miraflores.";

const allStacks = [stacks.clientWant, stacks.recommended, stacks.hybrid] as const;
---

<QuoteLayout title={pageTitle} description={pageDescription}>
  <main class="w-full max-w-full overflow-x-clip py-5 pb-8 sm:py-8 md:py-14 lg:py-16">
    <article class="sheet">
      <header class="px-4 pt-6 pb-8 sm:px-6 sm:pt-8 sm:pb-10 md:px-12 md:pt-12 md:pb-14">
        <div class="mb-6 flex items-start justify-between gap-3 sm:mb-8 sm:items-center sm:gap-4 fade-rise">
          <p class="meta-label m-0 min-w-0 break-all">Propuesta técnica</p>
          <a
            href="/"
            class="print-btn no-print"
          >
            Ver cotización
          </a>
        </div>

        <div class="fade-rise min-w-0">
          <h1 class="display m-0 text-[clamp(2.35rem,9vw,4.5rem)] text-ink text-balance">
            Qué stack elegir
          </h1>
          <p class="prose-measure mt-4 text-base text-ink-soft sm:text-lg md:text-xl">
            Tres caminos posibles para el sitio Dazzler Miraflores. Cada uno tiene sus ventajas; la decisión depende de qué priorice el hotel.
          </p>
          <p class="prose-measure mt-3 text-sm text-ink-faint sm:text-base">
            Esta comparativa es transparente: presentamos pros, contras y una matriz de decisión. La recomendación es clara, pero la decisión es del cliente.
          </p>
        </div>
      </header>

      <hr class="section-rule" />

      <!-- Stack cards -->
      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="opciones">
        <h2 id="opciones" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl mb-8">
          Las tres opciones
        </h2>
        <div class="space-y-8">
          {
            allStacks.map((stack, i) => (
              <div class:list={["stack-card", { "stack-card--recommended": i === 1 }]}>
                <div class="stack-card__header">
                  <div>
                    <p class="meta-label m-0">{stack.tagline}</p>
                    <h3 class="display m-0 mt-1 text-xl sm:text-2xl md:text-3xl">{stack.name}</h3>
                  </div>
                  <div class="stack-card__score">
                    <span class="stack-card__score-label">Hotel</span>
                    <span class="stack-card__score-value">{stack.hotelScore}</span>
                  </div>
                </div>

                <p class="stack-card__verdict">{stack.verdict}</p>

                <div class="grid gap-6 sm:grid-cols-2">
                  <div>
                    <h4 class="meta-label m-0 mb-3">Ventajas</h4>
                    <ul class="stack-list text-ink-soft">
                      {stack.pros.map((item) => (
                        <li class="break-words">
                          <span class="stack-card__pro" aria-hidden="true">+</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="meta-label m-0 mb-3">Limitaciones</h4>
                    <ul class="stack-list text-ink-soft">
                      {stack.cons.map((item) => (
                        <li class="break-words">
                          <span class="stack-card__con" aria-hidden="true">-</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="stack-card__footer">
                  <p class="text-sm text-ink-faint">
                    <strong class="font-medium text-ink-soft">Ideal para:</strong> {stack.bestFor}
                  </p>
                  <p class="text-sm text-ink-faint mt-2">
                    <strong class="font-medium text-ink-soft">Para Dazzler:</strong> {stack.hotelNote}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <hr class="section-rule" />

      <!-- Decision matrix -->
      <section class="px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="matriz">
        <h2 id="matriz" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl mb-2">
          Matriz de decisión
        </h2>
        <p class="prose-measure mb-8 text-sm text-ink-faint">
          Del 1 (mínimo) al 5 (máximo). Puntuación basada en requisitos de un hotel premium con multiidioma, SEO/AEO y reserva directa.
        </p>

        <div class="table-scroll">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th class="meta-label pb-3 pr-3 font-medium">Dimensión</th>
                <th class="meta-label pb-3 pr-3 font-medium">WP + Elementor</th>
                <th class="meta-label pb-3 pr-3 font-medium">Astro + Sanity</th>
                <th class="meta-label pb-3 font-medium">Astro + WP headless</th>
              </tr>
            </thead>
            <tbody>
              {
                decisionMatrix.map((row) => (
                  <tr class="border-b border-line align-top">
                    <td class="py-3 pr-3 text-ink-soft">{row.dimension}</td>
                    <td class="py-3 pr-3">
                      <span class:list={["score", { "score--low": Number(row.wpElementor) <= 2, "score--mid": Number(row.wpElementor) === 3, "score--high": Number(row.wpElementor) >= 4 }]}>
                        {row.wpElementor}
                      </span>
                    </td>
                    <td class="py-3 pr-3">
                      <span class:list={["score", { "score--low": Number(row.astroSanity) <= 2, "score--mid": Number(row.astroSanity) === 3, "score--high": Number(row.astroSanity) >= 4 }]}>
                        {row.astroSanity}
                      </span>
                    </td>
                    <td class="py-3">
                      <span class:list={["score", { "score--low": Number(row.astroWpHeadless) <= 2, "score--mid": Number(row.astroWpHeadless) === 3, "score--high": Number(row.astroWpHeadless) >= 4 }]}>
                        {row.astroWpHeadless}
                      </span>
                    </td>
                  </tr>
                ))
              }
              <tr class="border-t-2 border-ink font-medium">
                <td class="py-4 pr-3 text-ink">Promedio</td>
                <td class="py-4 pr-3">
                  <span class="score score--low">2.7</span>
                </td>
                <td class="py-4 pr-3">
                  <span class="score score--high">4.6</span>
                </td>
                <td class="py-4">
                  <span class="score score--mid">3.6</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <hr class="section-rule" />

      <!-- Recommendation -->
      <section class="invest-band px-4 py-8 sm:px-6 sm:py-10 md:px-12 md:py-12" aria-labelledby="recomendacion">
        <div class="max-w-prose">
          <h2 id="recomendacion" class="display m-0 text-[1.85rem] sm:text-3xl md:text-4xl text-accent-ink">
            Nuestra recomendación
          </h2>
          <p class="mt-5 text-lg text-accent-ink/90 leading-relaxed">
            Para un hotel de marca como Dazzler, con necesidad de multiidioma, SEO/AEO como diferencial y reserva directa vía TravelClick, <strong>Astro + Sanity</strong> es la opción que mejor equilibra rendimiento, control editorial y costo operativo.
          </p>
          <p class="mt-4 text-accent-ink/80 leading-relaxed">
            Si el equipo insiste en WordPress, podemos explorar <strong>Astro + WordPress headless</strong>: ganamos velocidad en el frontend sin cambiar el CMS, aunque se mantiene la dependencia de plugins para multiidioma y seguridad.
          </p>
          <p class="mt-4 text-accent-ink/80 leading-relaxed">
            Lo que no recomendamos es <strong>WordPress + Elementor</strong> para este caso: el site actual ya fue construido así y los límites de rendimiento, SEO y multiidioma son precisamente lo que esta propuesta busca resolver.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/"
              class="inline-flex items-center justify-center border border-accent-ink bg-transparent px-6 py-3 text-sm font-medium text-accent-ink no-underline transition-colors hover:bg-accent-ink hover:text-accent"
            >
              Ver cotización completa
            </a>
            <a
              href={quote.issuer.contacts[1].whatsappHref}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center border border-accent-ink bg-accent-ink px-6 py-3 text-sm font-medium text-accent no-underline transition-colors hover:bg-transparent hover:text-accent-ink"
            >
              Consultar dudas por WhatsApp
            </a>
          </div>
        </div>
      </section>

      <footer class="border-t border-line px-4 py-6 sm:px-6 sm:py-8 md:px-12">
        <p class="m-0 text-sm text-ink-faint">
          Propuesta técnica de <span class="font-medium text-ink-soft">{quote.issuer.name}</span> para {quote.client.name}
        </p>
      </footer>
    </article>
  </main>
</QuoteLayout>
