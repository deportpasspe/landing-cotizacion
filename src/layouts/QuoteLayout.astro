---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: A precision atelier ledger — a commercial proposal that reads as craft documentation, not a SaaS landing; refuses metric-hero cards and purple-glow templates.
      OWN-WORLD: Cool stone paper ground (#ECEAE6), charcoal ink, single deep slate-teal accent; Cabinet Grotesk + Satoshi; hairline rules and open tabular investment band.
      STORY: A stage-race organizer understands the audited opportunity, why story, UX and UI precede code, and how registration can evolve from assisted payment to an integrated participant platform.
      FIRST VIEWPORT: Oversized UX Factory wordmark, RUC, client reference and one-line offer; print action in the top rail; brand dominates before any section chrome.
      FORM: Brief-pinned sleek neutro premium · grounded #7 Atelier Ledger · seed f0fc6460 (assignment superseded by pinned brief).
      FINISH: polish + DESIGN.md complete · detector clean on dist/index.html · verdict: ship for client review
    -->
    <div class="page-atmosphere" aria-hidden="true"></div>
    <slot />
  </body>
</html>
